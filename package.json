{
  "name": "hireme-website",
  "private": true,
  "version": "1.09.01",
  "type": "module",
  "scripts": {
    "start": "vite --host --open",
    "dev": "vite --host --open",
    "serve": "vite --host --open",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --host --open",
    "desktop:install": "npm --prefix desktop install",
    "desktop:dev": "npm --prefix desktop run dev:exe",
    "desktop:build": "npm --prefix desktop run build",
    "desktop:dist": "npm --prefix desktop run dist"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "lucide-react": "^1.45.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
